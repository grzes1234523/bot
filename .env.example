# Wypełnij danymi Discord Developer Portal / swojego serwera
DISCORD_TOKEN=WKLEJ_TUTAJ_TOKEN_BOTA
CLIENT_ID=123456789012345678
GUILD_ID=123456789012345678

# Prywatny kanał administracji, na który trafiają podania
APPLICATION_CHANNEL_ID=123456789012345678

# Identyfikator roli automatycznie nadawanej po akceptacji (NIE nazwa!)
ACCEPTED_ROLE_ID=123456789012345678

# Opcjonalne: rola osób mogących rozpatrywać podania
# Osoby z Manage Server / Administrator też mogą to robić
STAFF_ROLE_ID=

# Opcjonalny kanał logów
LOG_CHANNEL_ID=

# Kanał statusu bota: pusty = automatycznie utwórz prywatny kanał status-bota.
# Do tworzenia bot wymaga Zarządzanie kanałami; Administrator i STAFF_ROLE_ID widzą raporty.
# Możesz wskazać ID własnego kanału tekstowego na tym samym serwerze.
BOT_STATUS_CHANNEL_ID=

# Przerwa po odrzuceniu/zamknięciu przed ponownym podaniem (0 = wyłącz)
REAPPLY_COOLDOWN_HOURS=24

# Nazwa wyświetlana w panelu i powiadomieniach
SERVER_DISPLAY_NAME=Strefa Gry i Rozrywki

# Panel WWW (OAuth2) — callback wpisz w Discord Developer Portal → OAuth2
CLIENT_SECRET=UZUPELNIJ_W_DEVELOPER_PORTAL
PANEL_BASE_URL=http://localhost:3000
PANEL_SESSION_SECRET=WSTAW_LOSOWY_SEKRET_MINIMUM_32_ZNAKI
PANEL_PORT=3000
PANEL_HOST=127.0.0.1

# Opcjonalne wspólne, trwałe dane PostgreSQL (Render lub własny serwer)
# Jeśli DATABASE_URL jest ustawione, ono staje się głównym magazynem; istniejące pliki JSON
# są używane tylko do pierwszego zasilenia pustych rekordów i nie są nadpisywane.
DATABASE_URL=
# Dla lokalnego połączenia przez publiczny adres bazy ustaw true; Render używa prywatnego URL bez TLS.
DATABASE_SSL=false
DATABASE_POOL_SIZE=5

# Opcjonalny katalog bazy poza folderem projektu (zalecany poza OneDrive na Windows)
# STREFA_BOT_DATA_DIR=C:\\StrefaBotData
